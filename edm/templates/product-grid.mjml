<mj-section background-color="#ffffff" padding="26px 24px 10px">
  <mj-column>
    <mj-text align="center" font-size="14px" font-weight="700" color="#1a1a1a">추천상품</mj-text>
    <mj-divider border-width="2px" border-color="#f5c842" width="36px" padding="8px 0 0" />
  </mj-column>
</mj-section>

{{#each productRows}}
<mj-section background-color="#ffffff" padding="10px 16px">
  {{#each this}}
  <mj-column css-class="mobile-stack" padding="8px">
    <mj-image src="{{image}}" alt="{{name}}" href="{{url}}" border-radius="6px" padding="0 0 8px" />
    {{#if isNew}}
    <mj-text align="center" padding="0 0 4px"><span class="new-pill">신규상품</span></mj-text>
    {{/if}}
    {{#if discountPercent}}
    <mj-text align="center" padding="0 0 4px"><span class="discount-pill">동종품비 최대 {{discountPercent}}% 절감</span></mj-text>
    {{/if}}
    <mj-text align="center" font-size="11.5px" color="#333333" padding="0 4px 2px" line-height="1.4">
      <a href="{{url}}" style="color:#333333;text-decoration:none;">{{name}}</a>
    </mj-text>
    <mj-text align="center" padding="0 0 2px"><span class="price-text">{{price}}원~</span></mj-text>
    {{#if spec}}
    <mj-text align="center" padding="0" css-class="spec-text"><span class="spec-text">{{spec}}</span></mj-text>
    {{/if}}
  </mj-column>
  {{/each}}
</mj-section>
{{/each}}
