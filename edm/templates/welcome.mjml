<mjml>
  <mj-head>
    <mj-title>{{ email_subject }}</mj-title>
    <mj-preview>{{ preheader }}</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif" />
      <mj-text font-size="14px" color="#333333" line-height="1.6" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#eeeeee" width="600px">

    {# ── 고정 블록 ── #}
    {% include 'blocks/header.mjml' %}

    {# ── 가변: 히어로 배너 ── #}
    {% include 'blocks/hero_banner.mjml' %}

    {# ── 가변: 본문 ── #}
    {% include 'blocks/body_text.mjml' %}

    {# ── 가변: 쿠폰 (쿠폰 캠페인일 때만 포함) ── #}
    {% if coupon_code %}
      {% include 'blocks/coupon.mjml' %}
    {% endif %}

    {# ── 고정 블록 ── #}
    {% include 'blocks/partner_logos.mjml' %}
    {% include 'blocks/footer.mjml' %}

  </mj-body>
</mjml>
