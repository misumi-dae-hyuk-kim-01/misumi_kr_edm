<mj-section background-color="#fff9e6" border="2px solid #F5C842" padding="24px">
  <mj-column>
    <mj-text align="center" font-size="34px" font-weight="700" color="#F5C842">{{discount}}%</mj-text>
    <mj-text align="center" font-size="11px" color="#aaaaaa" letter-spacing="2px" padding-bottom="12px">DISCOUNT</mj-text>
    <mj-text align="center" padding="0">
      <span style="display:inline-block;border:2px dashed #cc0000;padding:8px 22px;border-radius:4px;font-size:18px;font-weight:700;color:#cc0000;letter-spacing:3px;">{{code}}</span>
    </mj-text>
    <mj-text align="center" font-size="11px" color="#999999" padding-top="8px">
      만료: {{expiry}} · 최소주문 {{minOrder}}원 · 최대할인 {{maxDiscount}}원
    </mj-text>
  </mj-column>
</mj-section>
