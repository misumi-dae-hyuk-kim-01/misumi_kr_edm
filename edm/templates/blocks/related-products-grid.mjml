{{#if relatedProducts}}
<mj-section background-color="#f7f8fa" padding="24px 24px 8px">
  <mj-column>
    <mj-text align="center" font-size="13px" font-weight="700" color="#1a1a1a">{{relatedSectionTitle}}</mj-text>
  </mj-column>
</mj-section>

{{#each relatedRows}}
<mj-section background-color="#f7f8fa" padding="6px 16px">
  {{#each this}}
  <mj-column css-class="mobile-stack" padding="6px">
    <mj-image src="{{image}}" alt="{{name}}" href="{{url}}" border-radius="6px" padding="0 0 6px" />
    <mj-text align="center" font-size="11px" color="#555555" padding="0">
      <a href="{{url}}" style="color:#555555;text-decoration:none;">{{name}}</a>
    </mj-text>
  </mj-column>
  {{/each}}
</mj-section>
{{/each}}
{{/if}}
